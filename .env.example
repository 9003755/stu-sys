# Copy to .env. Use a TEST project for development and destructive QA.
# VITE_* values are public in the browser. NEVER put a service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Empty values use the current origin (recommended for local development).
VITE_APP_SITE_URL=
VITE_SUPER_SITE_URL=
# Historical VITE_SUPABASE_SUPER_* variables are not read by current clients.
# All three roles use VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY.
